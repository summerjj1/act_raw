class EpisodicDatasetDualArm(torch.utils.data.Dataset):
    """双臂 HDF5 数据：/robot_0、/robot_1，每臂 action{T,7}, observations/qpos{T,7}, observations/images/front{T,H,W,3}。"""
    def __init__(self, episode_ids, dataset_dir, camera_names, norm_stats, robot_prefixes, episode_files):
        super(EpisodicDatasetDualArm).__init__()
        self.episode_ids = episode_ids
        self.dataset_dir = dataset_dir
        self.camera_names = camera_names
        self.norm_stats = norm_stats
        self.robot_prefixes = robot_prefixes
        self.episode_files = episode_files  # 如 ['episode_000000.hdf5', ...]

    def __len__(self):
        return len(self.episode_ids)

    def __getitem__(self, index):
        sample_full_episode = False
        real_idx = self.episode_ids[index]
        dataset_path = os.path.join(self.dataset_dir, self.episode_files[real_idx])
        with h5py.File(dataset_path, 'r') as root:
            r0_action = root[f'{self.robot_prefixes[0]}/action']
            episode_len = r0_action.shape[0]
            if sample_full_episode:
                start_ts = 0
            else:
                start_ts = np.random.choice(episode_len)
            # 双臂 qpos 拼接 (7+7=14)
            qpos0 = root[f'{self.robot_prefixes[0]}/observations/qpos'][start_ts]
            qpos1 = root[f'{self.robot_prefixes[1]}/observations/qpos'][start_ts]
            qpos = np.concatenate([qpos0, qpos1]).astype(np.float32)
            # 双臂图像：每臂一个 front，顺序 [robot_0/front, robot_1/front]
            image_dict = {}
            for i, prefix in enumerate(self.robot_prefixes):
                for cam_name in self.camera_names:
                    key = (prefix, cam_name)
                    image_dict[key] = root[f'{prefix}/observations/images/{cam_name}'][start_ts]
            # 双臂 action 拼接 (T, 7+7=14)，从 start_ts 起
            action0 = root[f'{self.robot_prefixes[0]}/action'][start_ts:]
            action1 = root[f'{self.robot_prefixes[1]}/action'][start_ts:]
            action_len = action0.shape[0]
            action = np.concatenate([action0, action1], axis=1).astype(np.float32)
        original_action_shape = (episode_len, 14)
        padded_action = np.zeros(original_action_shape, dtype=np.float32)
        padded_action[:action_len] = action
        is_pad = np.zeros(episode_len)
        is_pad[action_len:] = 1
        # 图像: [cam0_robot0, cam0_robot1] -> (2, H, W, C)
        all_cam_images = []
        for prefix in self.robot_prefixes:
            for cam_name in self.camera_names:
                all_cam_images.append(image_dict[(prefix, cam_name)])
        all_cam_images = np.stack(all_cam_images, axis=0)
        image_data = torch.from_numpy(all_cam_images)
        qpos_data = torch.from_numpy(qpos).float()
        action_data = torch.from_numpy(padded_action).float()
        is_pad = torch.from_numpy(is_pad).bool()
        image_data = torch.einsum('k h w c -> k c h w', image_data)
        image_data = image_data / 255.0
        action_data = (action_data - self.norm_stats["action_mean"]) / self.norm_stats["action_std"]
        qpos_data = (qpos_data - self.norm_stats["qpos_mean"]) / self.norm_stats["qpos_std"]
        action_data = action_data.float()
        qpos_data = qpos_data.float()
        return image_data, qpos_data, action_data, is_pad


def get_norm_stats_dual_arm(dataset_dir, robot_prefixes, episode_files):
    all_qpos = []
    all_action = []
    for fname in episode_files:
        path = os.path.join(dataset_dir, fname)
        with h5py.File(path, 'r') as root:
            q0 = root[f'{robot_prefixes[0]}/observations/qpos'][()]
            q1 = root[f'{robot_prefixes[1]}/observations/qpos'][()]
            a0 = root[f'{robot_prefixes[0]}/action'][()]
            a1 = root[f'{robot_prefixes[1]}/action'][()]
        qpos = np.concatenate([q0, q1], axis=1)
        action = np.concatenate([a0, a1], axis=1)
        all_qpos.append(qpos)
        all_action.append(action)
    all_qpos = np.concatenate(all_qpos, axis=0)   # (total_steps, 14)
    all_action = np.concatenate(all_action, axis=0)  # (total_steps, 14)
    action_mean = all_action.mean(axis=0)
    action_std = all_action.std(axis=0)
    action_std = np.clip(action_std, 1e-2, np.inf)
    qpos_mean = all_qpos.mean(axis=0)
    qpos_std = all_qpos.std(axis=0)
    qpos_std = np.clip(qpos_std, 1e-2, np.inf)
    stats = {
        "action_mean": action_mean.astype(np.float32),
        "action_std": action_std.astype(np.float32),
        "qpos_mean": qpos_mean.astype(np.float32),
        "qpos_std": qpos_std.astype(np.float32),
        "example_qpos": all_qpos[:1],
    }
    return stats


def load_data_dual_arm(dataset_dir, num_episodes, camera_names, batch_size_train, batch_size_val, robot_prefixes, episode_files=None, return_datasets=False):
    if episode_files is None:
        episode_files = [f'episode_{i:06d}.hdf5' for i in range(num_episodes)]
    assert len(episode_files) == num_episodes
    if not return_datasets:
        print(f'\nDual-arm data from: {dataset_dir}, {num_episodes} episodes\n')
    train_ratio = 0.95
    shuffled_indices = np.random.permutation(num_episodes)
    if num_episodes == 1:
        train_indices = shuffled_indices
        val_indices = shuffled_indices
    else:
        split = min(max(1, int(train_ratio * num_episodes)), num_episodes - 1)
        train_indices = shuffled_indices[:split]
        val_indices = shuffled_indices[split:]
    norm_stats = get_norm_stats_dual_arm(dataset_dir, robot_prefixes, episode_files)
    train_dataset = EpisodicDatasetDualArm(train_indices, dataset_dir, camera_names, norm_stats, robot_prefixes, episode_files)
    val_dataset = EpisodicDatasetDualArm(val_indices, dataset_dir, camera_names, norm_stats, robot_prefixes, episode_files)
    if return_datasets:
        return train_dataset, val_dataset, norm_stats
    train_dataloader = DataLoader(train_dataset, batch_size=batch_size_train, shuffle=True, pin_memory=True, num_workers=1, prefetch_factor=1)
    val_dataloader = DataLoader(val_dataset, batch_size=batch_size_val, shuffle=True, pin_memory=True, num_workers=1, prefetch_factor=1)
    return train_dataloader, val_dataloader, norm_stats, False


def make_policy(policy_class, policy_config):
    if policy_class == "ACT":
        policy = ACTPolicy(policy_config)
    elif policy_class == "CNNMLP":
        policy = CNNMLPPolicy(policy_config)
    else:
        raise ValueError(f"Unknown policy class: {policy_class}")
    return policy

def make_optimizer(policy_class, policy):
    if policy_class == 'ACT':
        optimizer = policy.configure_optimizers()
    elif policy_class == 'CNNMLP':
        optimizer = policy.configure_optimizers()
    else:
        raise ValueError(f"Unknown policy class: {policy_class}")
    return optimizer

### env utils

def sample_box_pose():
    x_range = [0.0, 0.2]
    y_range = [0.4, 0.6]
    z_range = [0.05, 0.05]

    ranges = np.vstack([x_range, y_range, z_range])
    cube_position = np.random.uniform(ranges[:, 0], ranges[:, 1])

    cube_quat = np.array([1, 0, 0, 0])
    return np.concatenate([cube_position, cube_quat])

def sample_insertion_pose():
    # Peg
    x_range = [0.1, 0.2]
    y_range = [0.4, 0.6]
    z_range = [0.05, 0.05]

    ranges = np.vstack([x_range, y_range, z_range])
    peg_position = np.random.uniform(ranges[:, 0], ranges[:, 1])

    peg_quat = np.array([1, 0, 0, 0])
    peg_pose = np.concatenate([peg_position, peg_quat])

    # Socket
    x_range = [-0.2, -0.1]
    y_range = [0.4, 0.6]
    z_range = [0.05, 0.05]

    ranges = np.vstack([x_range, y_range, z_range])
    socket_position = np.random.uniform(ranges[:, 0], ranges[:, 1])

    socket_quat = np.array([1, 0, 0, 0])
    socket_pose = np.concatenate([socket_position, socket_quat])

    return peg_pose, socket_pose

### helper functions

def get_image(images, camera_names, device='cuda'):
    curr_images = []
    for cam_name in camera_names:
        curr_image = rearrange(images[cam_name], 'h w c -> c h w')
        curr_images.append(curr_image)
    curr_image = np.stack(curr_images, axis=0)
    # cv2.imshow("cam", curr_image)
    # cv2.waitKey(0) 
    curr_image = torch.from_numpy(curr_image / 255.0).float().to(device).unsqueeze(0)
    return curr_image

def compute_dict_mean(epoch_dicts):
    result = {k: None for k in epoch_dicts[0]}
    num_items = len(epoch_dicts)
    for k in result:
        value_sum = 0
        for epoch_dict in epoch_dicts:
            value_sum += epoch_dict[k]
        result[k] = value_sum / num_items
    return result

def detach_dict(d):
    new_d = dict()
    for k, v in d.items():
        new_d[k] = v.detach()
    return new_d

def set_seed(seed):
    torch.manual_seed(seed)
    np.random.seed(seed)


def pos2pwm(pos:np.ndarray) -> np.ndarray:
    """
    :param pos: numpy array of joint positions in range [-pi, pi]
    :return: numpy array of pwm values in range [0, 4096]
    """ 
    return (pos / 3.14 + 1.) * 2048
    
def pwm2pos(pwm:np.ndarray) -> np.ndarray:
    """
    :param pwm: numpy array of pwm values in range [0, 4096]
    :return: numpy array of joint positions in range [-pi, pi]
    """
    return (pwm / 2048 - 1) * 3.14

def pwm2vel(pwm:np.ndarray) -> np.ndarray:
    """
    :param pwm: numpy array of pwm/s joint velocities
    :return: numpy array of rad/s joint velocities 
    """
    return pwm * 3.14 / 2048

def vel2pwm(vel:np.ndarray) -> np.ndarray:
    """
    :param vel: numpy array of rad/s joint velocities
    :return: numpy array of pwm/s joint velocities
    """
    return vel * 2048 / 3.14
    
def pwm2norm(x:np.ndarray) -> np.ndarray:
    """
    :param x: numpy array of pwm values in range [0, 4096]
    :return: numpy array of values in range [0, 1]
    """
    return x / 4096
    
def norm2pwm(x:np.ndarray) -> np.ndarray:
    """
    :param x: numpy array of values in range [0, 1]
    :return: numpy array of pwm values in range [0, 4096]
    """
    return x * 4096
