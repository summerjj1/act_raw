class EpisodicDatasetSingleArm(torch.utils.data.Dataset):
    """单臂 HDF5 数据：每条样本返回 image、qpos(7)、action(T,7)、is_pad。"""
    def __init__(
            self, episode_ids, dataset_dir, camera_names, norm_stats,
            episode_files, episode_len=None, raw_black_level=64,
            raw_white_level=1023, raw_gamma=2.2):
        super(EpisodicDatasetSingleArm).__init__()
        self.episode_ids = episode_ids
        self.dataset_dir = dataset_dir
        self.camera_names = camera_names
        self.norm_stats = norm_stats
        self.episode_files = episode_files
        self.episode_len = episode_len
        self.raw_black_level = raw_black_level
        self.raw_white_level = raw_white_level
        self.raw_gamma = raw_gamma

    def __len__(self):
        return len(self.episode_ids)

    def __getitem__(self, index):
        sample_full_episode = False
        real_idx = self.episode_ids[index]
        dataset_path = os.path.join(self.dataset_dir, self.episode_files[real_idx])
        with h5py.File(dataset_path, 'r') as root:
            action_ds = root['action']
            episode_len = action_ds.shape[0]
            if sample_full_episode:
                start_ts = 0
            else:
                start_ts = np.random.choice(episode_len)

            qpos = root['observations/qpos'][start_ts].astype(np.float32)
            image_dict = {}
            for cam_name in self.camera_names:
                image_dict[cam_name] = root[f'observations/images/{cam_name}'][start_ts]

            image_encoding = root.attrs.get('image_encoding', 'rgb_uint8')
            if isinstance(image_encoding, bytes):
                image_encoding = image_encoding.decode('utf-8')
            raw_black_level = int(root.attrs.get(
                'raw_black_level', self.raw_black_level
            ))
            raw_white_level = int(root.attrs.get(
                'raw_white_level', self.raw_white_level
            ))

            action = action_ds[start_ts:].astype(np.float32)

        target_episode_len = self.episode_len or episode_len
        original_action_shape = (target_episode_len, action.shape[1])
        padded_action = np.zeros(original_action_shape, dtype=np.float32)
        action_len = min(action.shape[0], target_episode_len)
        action = action[:action_len]
        padded_action[:action_len] = action
        is_pad = np.zeros(target_episode_len)
        is_pad[action_len:] = 1

        all_cam_images = []
        for cam_name in self.camera_names:
            all_cam_images.append(image_dict[cam_name])
        all_cam_images = np.stack(all_cam_images, axis=0)

        if image_encoding == 'bggr10_planes_uint16':
            if all_cam_images.ndim != 4 or all_cam_images.shape[1] != 4:
                raise ValueError(
                    f'{dataset_path}: expected raw image shape (K,4,H,W), '
                    f'got {all_cam_images.shape}'
                )
            if not (
                    0 <= raw_black_level
                    < raw_white_level <= 1023):
                raise ValueError('Invalid raw black/white level')
            image_data = torch.from_numpy(all_cam_images).float()
            image_data = torch.clamp(
                (image_data - float(raw_black_level))
                / float(raw_white_level - raw_black_level),
                0.0,
                1.0,
            )
            if self.raw_gamma != 1.0:
                image_data = image_data.pow(1.0 / self.raw_gamma)
        else:
            image_data = torch.from_numpy(all_cam_images)
            image_data = torch.einsum(
                'k h w c -> k c h w', image_data
            )
            image_data = image_data / 255.0

        qpos_data = torch.from_numpy(qpos).float()
        action_data = torch.from_numpy(padded_action).float()
        is_pad = torch.from_numpy(is_pad).bool()
        action_data = (action_data - self.norm_stats["action_mean"]) / self.norm_stats["action_std"]
        qpos_data = (qpos_data - self.norm_stats["qpos_mean"]) / self.norm_stats["qpos_std"]
        action_data = action_data.float()
        qpos_data = qpos_data.float()

        return image_data, qpos_data, action_data, is_pad


def get_norm_stats_single_arm(dataset_dir, episode_files):
    all_qpos = []
    all_action = []
    for fname in episode_files:
        path = os.path.join(dataset_dir, fname)
        with h5py.File(path, 'r') as root:
            qpos = root['observations/qpos'][()].astype(np.float32)
            action = root['action'][()].astype(np.float32)
        all_qpos.append(qpos)
        all_action.append(action)
    all_qpos = np.concatenate(all_qpos, axis=0)
    all_action = np.concatenate(all_action, axis=0)
    action_mean = all_action.mean(axis=0)
    action_std = all_action.std(axis=0)
    action_std = np.clip(action_std, 1e-2, np.inf)
    qpos_mean = all_qpos.mean(axis=0)
    qpos_std = all_qpos.std(axis=0)
    qpos_std = np.clip(qpos_std, 1e-2, np.inf)
    stats = {
        "action_mean": action_mean.astype(np.float32),
        "action_std": action_std.astype(np.float32),
        "qpos_mean": qpos_mean.astype(np.float32),
        "qpos_std": qpos_std.astype(np.float32),
        "example_qpos": all_qpos[:1],
    }
    return stats


def load_data_single_arm(
        dataset_dir, num_episodes, camera_names, batch_size_train,
        batch_size_val, episode_files=None, episode_len=None,
        return_datasets=False, raw_black_level=64, raw_white_level=1023,
        raw_gamma=2.2):
    if episode_files is None:
        episode_files = [f'episode_{i:06d}.hdf5' for i in range(num_episodes)]
    assert len(episode_files) == num_episodes
    if not return_datasets:
        print(f'\nSingle-arm data from: {dataset_dir}, {num_episodes} episodes\n')
    train_ratio = 0.95
    shuffled_indices = np.random.permutation(num_episodes)
    if num_episodes == 1:
        train_indices = shuffled_indices
        val_indices = shuffled_indices
    else:
        split = min(max(1, int(train_ratio * num_episodes)), num_episodes - 1)
        train_indices = shuffled_indices[:split]
        val_indices = shuffled_indices[split:]
    norm_stats = get_norm_stats_single_arm(dataset_dir, episode_files)
    dataset_kwargs = {
        'dataset_dir': dataset_dir,
        'camera_names': camera_names,
        'norm_stats': norm_stats,
        'episode_files': episode_files,
        'episode_len': episode_len,
        'raw_black_level': raw_black_level,
        'raw_white_level': raw_white_level,
        'raw_gamma': raw_gamma,
    }
    train_dataset = EpisodicDatasetSingleArm(
        train_indices, **dataset_kwargs
    )
    val_dataset = EpisodicDatasetSingleArm(
        val_indices, **dataset_kwargs
    )
    if return_datasets:
        return train_dataset, val_dataset, norm_stats
    train_dataloader = DataLoader(train_dataset, batch_size=batch_size_train, shuffle=True, pin_memory=True, num_workers=1, prefetch_factor=1)
    val_dataloader = DataLoader(val_dataset, batch_size=batch_size_val, shuffle=True, pin_memory=True, num_workers=1, prefetch_factor=1)
    return train_dataloader, val_dataloader, norm_stats, False

